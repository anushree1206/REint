# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Frontend Configuration
# Leave empty in local dev to use Vite reverse proxy (/api -> backend:8001)
# In production, set to your deployed backend origin (e.g., https://windlens-api.onrender.com)
VITE_API_BASE_URL=""

# Backend Configuration (Python FastAPI)
ELEXON_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
REQUEST_TIMEOUT_SECONDS=25.0
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"
PORT=8001
HOST="0.0.0.0"

